# 请复制为 .env，仅配置本项目专用服务；不要提交真实凭证。
# LabApplication 启动时自动读取工作目录下的 .env，IDEA 工作目录应设为项目根目录。
# 显式环境变量、JVM 参数及命令行参数优先；IDEA 已填写的同名环境变量会覆盖这里。
# 格式为 KEY=value，使用 UTF-8；值按字面填写，不加引号、不使用行内注释或脚本。
# 修改配置后重启后端生效；只有独立的整行 # 注释会被忽略。

# 仅 Docker Compose 初始化 MySQL root 账户使用；后端业务连接不使用此项。
MYSQL_ROOT_PASSWORD=

# 仅 Docker Compose 初始化业务数据库用户使用；使用容器时应与 DB_PASSWORD 一致。
MYSQL_PASSWORD=

# MySQL 8.4 JDBC 连接地址；建议包含 connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true。
DB_URL=jdbc:mysql://localhost:3306/ailab?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true

# 本项目专用数据库用户名，应具备业务表读写和 Flyway 迁移权限。
DB_USERNAME=ailab

# 数据库用户密码，按字面填写，不加引号；请勿提交或分享。
DB_PASSWORD=

# 首次空用户库初始化管理员的开关；已有用户时应为 false。
BOOTSTRAP_ENABLED=false

# 首次初始化管理员的用户名，仅 BOOTSTRAP_ENABLED=true 时使用。
BOOTSTRAP_USERNAME=admin

# 首次初始化管理员的强密码；初始化完成后可清空，请勿提交或分享。
BOOTSTRAP_PASSWORD=

# 是否启用真实 ES 搜索；设为 true 前先执行 scripts/init-index.ps1 创建索引。
SEARCH_ENABLED=false

# 是否自动处理文档入库队列；需同时 SEARCH_ENABLED=true 和可用 Embedding 模型。
INGESTION_WORKER_ENABLED=true

# 是否自动执行 FAQ/研究报告队列；开启后会按已有配置调用模型，与入库开关独立。
TASK_WORKER_ENABLED=true

# Elasticsearch 8.15 服务地址，包含 http/https 协议；不要在地址中携带用户名密码。
ES_URL=http://localhost:9200

# ES Basic 认证用户名，必须与 ES_PASSWORD 成对配置；无认证时两项均留空。
ES_USERNAME=

# ES Basic 认证密码；请勿提交或分享。
ES_PASSWORD=

# 自定义可信 CA 证书文件路径；仅 ES_TRUST_ALL=false 时参与证书验证，可留空使用系统信任。
ES_CA_CERTIFICATE=

# 知识切片索引名称；Embedding 模型或维度变化时必须使用新索引。
ES_INDEX=knowledge_chunks_mock_v1

# 模型模式：mock 为离线模拟，real 使用真实模型；真实服务失败不会自动变成 Mock。
MODEL_MODE=mock

# 是否明确允许资料发送给外部模型；MODEL_MODE=real 必须设为 true。
MODEL_EXTERNAL_DATA_ALLOWED=false

# 主对话模型的供应商模型名称，应为服务实际支持的模型。
MODEL_PRIMARY_NAME=mock-primary

# 备用对话模型名称，仅启用备用模型时使用。
MODEL_BACKUP_NAME=mock-backup

# 是否启用备用对话模型；只有一个实际目标时设为 false，主备不能是同一实际目标。
MODEL_BACKUP_ENABLED=true

# 主对话模型兼容 OpenAI 协议的基础地址，按供应商要求填写路径。
MODEL_BASE_URL=https://api.openai.com/v1

# 备用对话模型基础地址；可以使用独立供应商。
MODEL_BACKUP_BASE_URL=https://api.openai.com/v1

# 主对话模型 API Key；由 MODEL_API_KEY 变量引用读取，请勿提交或分享。
MODEL_API_KEY=

# 备用对话模型 API Key；仅启用备用时要求有效，请勿提交或分享。
MODEL_BACKUP_API_KEY=

# Embedding 供应商模型名称；决定向量空间，变更后必须使用新 ES_INDEX。
EMBEDDING_MODEL_NAME=mock-embedding-v1

# 是否启用向量模型；文档自动入库需要开启并提供有效模型配置。
EMBEDDING_ENABLED=true

# Embedding 服务基础地址；若要沿用对话地址，请移除该配置项，空值不代表自动回退。
# EMBEDDING_BASE_URL=https://your-embedding-provider/v1

# Embedding 密钥变量名称，例如 EMBEDDING_API_KEY；这里不能填写密钥本身。
# EMBEDDING_CREDENTIAL_REF=EMBEDDING_API_KEY

# 独立 Embedding 服务 API Key；请勿提交或分享。
# EMBEDDING_API_KEY=

# 向量维度，必须同时匹配模型支持维度及 ES 索引映射；当前真实测试使用 2048。
EMBEDDING_DIMENSIONS=32

# 后端 HTTP 监听端口；默认 8080，端口冲突时可修改。
PORT=8080

# 是否跳过 ES 证书链及主机名验证；当前测试可用 true，恢复验证时设为 false。
ES_TRUST_ALL=false


# 日志文件目录；相对路径以进程工作目录为基准，支持绝对路径。
LOG_PATH=./var/logs
# 框架和业务日志级别；排查时业务级别可调整为 DEBUG。
LOG_LEVEL=INFO
LAB_LOG_LEVEL=INFO
# 单文件滚动阈值、归档保留天数及两类归档总大小。
LOG_MAX_FILE_SIZE=20MB
LOG_MAX_HISTORY_DAYS=30
LOG_MAX_ARCHIVE_SIZE=1GB

# 模型与工具等待配置范围1～120秒；媒体任务可用较长等待，在线单次仍最多30秒。
MODEL_PRIMARY_TIMEOUT_SECONDS=90
MODEL_BACKUP_TIMEOUT_SECONDS=90
# 工具整体截止时间包含排队、授权复核、远程向量及检索。
TOOL_TIMEOUT_SECONDS=90
