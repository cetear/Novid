<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ailab.data.persistence.mapper.KnowledgeBaseMapper">
    <select id="listAuthorized" resultType="com.example.ailab.data.persistence.po.KnowledgeBasePo">
        SELECT k.* FROM knowledge_bases k
        WHERE <include refid="com.example.ailab.data.persistence.mapper.SqlSupportMapper.knowledgeScope"/>
        ORDER BY k.id LIMIT #{params.limit} OFFSET #{params.offset}
    </select>
</mapper>
