<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ailab.data.persistence.mapper.WorkflowRunMapper">
    <select id="binding" resultType="com.example.ailab.data.persistence.po.SqlRow">
        SELECT binding_hash,binding_json FROM task_workflow_bindings WHERE task_id=#{args[0]}
    </select>
    <insert id="bind">
        INSERT INTO task_workflow_bindings(task_id,binding_hash,binding_json) VALUES(#{args[0]},#{args[1]},#{args[2]})
    </insert>
</mapper>
