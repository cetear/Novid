<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example.ailab</groupId>
        <artifactId>Novid</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>lab-dist</artifactId>
    <description>Linux 部署入口，复用 lab-app 正式装配和运行配置。</description>
    <dependencies>
        <dependency>
            <groupId>com.example.ailab</groupId>
            <artifactId>lab-app</artifactId>
            <version>${project.version}</version>
            <classifier>lib</classifier>
        </dependency>
    </dependencies>
    <build>
        <finalName>novid</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.example.ailab.app.LabApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.7.1</version>
                        <configuration>
                            <descriptors><descriptor>src/assembly/dist.xml</descriptor></descriptors>
                            <finalName>dist</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                        </configuration>
                        <executions>
                            <execution>
                                <id>distribution</id>
                                <phase>package</phase>
                                <goals><goal>single</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
